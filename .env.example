# Application Configuration
NODE_ENV=development
PORT=3000

# Request Body Size Limits (in MB)
BODY_LIMIT_JSON=10
BODY_LIMIT_URLENCODED=10

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=nexafx_db
DB_SSL=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_characters_long_for_security
JWT_EXPIRY=3600

# Refresh Token Configuration
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_must_be_at_least_32_characters_long
REFRESH_TOKEN_EXPIRY=604800

# OTP Configuration
OTP_SECRET=your_super_secret_otp_key_must_be_at_least_32_characters_long
OTP_EXPIRY=300

# Wallet Encryption Configuration (required — exactly 64 lowercase hex chars)
# Generate with: openssl rand -hex 32
# Wallet Encryption Configuration (exactly 64 lowercase hex chars, generated via `openssl rand -hex 32`)
WALLET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# External Service Credentials
EXTERNAL_API_KEY=your_external_api_key
EXTERNAL_API_URL=https://api.example.com
EXTERNAL_API_TIMEOUT=30000

# Mail Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM=noreply@example.com
MAIL_SECURE=false

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Idempotency Configuration
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_CLEANUP_CRON=0 0 * * *

# Blockchain Configuration
# RPC endpoint for blockchain interaction (Ethereum mainnet, testnet, or custom node)
BLOCKCHAIN_RPC_URL=http://localhost:8545
# Number of confirmations required for transaction finalization
BLOCKCHAIN_REQUIRED_CONFIRMATIONS=12

# Payment Provider Configuration
# API endpoint for the payment provider (e.g., Stripe, PayPal, Square)
PROVIDER_API_URL=https://api.payment-provider.com
# API key for authentication with the payment provider
PROVIDER_API_KEY=your_provider_api_key_here
# Timeout in milliseconds for provider API calls
PROVIDER_API_TIMEOUT=30000

# ============================================
# Push Notification Configuration
# ============================================
# FCM Server key for Android push notifications
FCM_SERVER_KEY=your_fcm_server_key_here
# APNs configuration for Apple push notifications
APNS_KEY_ID=ABC123DEF
APNS_TEAM_ID=DEF456GHI
APNS_BUNDLE_ID=com.example.app
# APNS private key (PEM) - newlines may need escaping in some environments
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ============================================
# Referral Program
# ============================================
# Reward amount given to referrer (numeric)
REFERRAL_REWARD_AMOUNT=10
# Maximum number of times a single referrer can receive rewards
REFERRAL_MAX_REFERRALS=100
# Enable or disable referral program (true|false)
REFERRAL_PROGRAM_ACTIVE=true

# ============================================
# AML Monitoring Tuning
# ============================================
# Structuring threshold (currency units)
AML_STRUCTURING_THRESHOLD=10000
# Hours window to consider for structuring detection
AML_STRUCTURING_WINDOW_HOURS=24
# Minimum count of transactions to flag structuring
AML_STRUCTURING_MIN_COUNT=3
# Smurfing window in hours
AML_SMURFING_WINDOW_HOURS=1
# Minimum distinct wallets for smurfing detection
AML_SMURFING_MIN_WALLETS=3
# Allowed percent variance for smurfing amounts
AML_SMURFING_VARIANCE_PCT=5
# Velocity detection window hours
AML_VELOCITY_WINDOW_HOURS=1
# Velocity detection max transaction count
AML_VELOCITY_MAX_COUNT=10
# Risk score weight (integer)
AML_RISK_SCORE_WEIGHT=30

# ============================================
# FX / Exchange Rates
# ============================================
# Minutes window to allow FX reversal
FX_REVERSAL_WINDOW_MINUTES=5
# API keys for exchange rate providers (optional)
OPEN_EXCHANGE_RATES_API_KEY=
EXCHANGE_RATE_HOST_API_KEY=

# --- Connection Pool ---
# Max connections in pool (default 10 is too low for production NestJS apps)
DB_POOL_MAX=20
# Min idle connections kept alive
DB_POOL_MIN=2
# Close idle connections after this many ms (10 minutes)
DB_POOL_IDLE_TIMEOUT_MS=600000
# Fail fast if a connection cannot be acquired within this window (30 seconds)
DB_POOL_ACQUIRE_TIMEOUT_MS=30000

# --- JWT Secret Rotation ---
JWT_SECRET=change-me-to-a-long-random-string
# Set this to the OLD JWT_SECRET during rotation; remove after all old tokens expire
JWT_SECRET_PREVIOUS=

# ============================================
# Logging & API Docs
# ============================================
# One of: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
# Expose the Swagger UI. Leave false in production.
SWAGGER_ENABLED=false
# Queries slower than this (ms) are logged as slow queries
SLOW_QUERY_THRESHOLD_MS=1000

# ============================================
# Stellar Network (required)
# ============================================
# SECURITY: secret seed (S...) for the hot wallet that signs outgoing payments.
# Treat as a production credential — never commit a real value. The app fails to
# start without it.
STELLAR_HOT_WALLET_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Comma-separated CODE:GADDRESS pairs for the issued assets this deployment
# accepts, e.g. USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
STELLAR_ASSET_ISSUERS=

# ============================================
# Admin Access Control
# ============================================
# SECURITY: comma-separated IPs/CIDRs allowed to reach admin and metrics routes.
# Leaving this empty disables the IP restriction — always set it in production.
ADMIN_ALLOWED_IPS=
# Where admin alerts are delivered (both optional)
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_SLACK_WEBHOOK_URL=
# Minimum minutes between repeat alerts of the same kind
ADMIN_ALERT_RATE_LIMIT_MINUTES=15

# ============================================
# Compliance
# ============================================
# SECURITY: comma-separated ISO 3166-1 alpha-2 codes to geo-block, e.g. KP,IR,SY.
# Leaving this empty means no country is blocked — set it deliberately.
BLOCKED_COUNTRIES=
# Version string of the terms users must have accepted
TERMS_CURRENT_VERSION=1.0
# Hostname documents uploaded for KYC must be served from. Empty disables the
# check, which allows a KYC document URL pointing at any host.
KYC_STORAGE_HOST=

# ============================================
# Currencies
# ============================================
# Comma-separated currency codes the platform accepts. Keep this in sync with
# SUPPORTED_CURRENCY_CODES in src/currencies/supported-currencies.ts.
SUPPORTED_CURRENCIES=USD,EUR,GBP,NGN

# ============================================
# Caching TTLs (seconds)
# ============================================
CACHE_EXCHANGE_RATE_TTL_SECONDS=60
CACHE_SUPPORTED_CURRENCIES_TTL_SECONDS=86400
CACHE_ADMIN_STATS_TTL_SECONDS=60
WALLET_BALANCE_CACHE_TTL_SECONDS=30

# ============================================
# Webhook Delivery
# ============================================
# Delivery attempts before a webhook is abandoned
WEBHOOK_MAX_ATTEMPTS=5
# Base delay (ms) for exponential backoff between attempts
WEBHOOK_BACKOFF_DELAY_MS=1000
# How long a signed webhook payload stays replayable
WEBHOOK_REPLAY_WINDOW_HOURS=24

# ============================================
# Data Archival
# ============================================
ARCHIVE_ENABLED=true
# Records older than this many months are archived
ARCHIVE_THRESHOLD_MONTHS=12
ARCHIVE_BATCH_SIZE=500
ARCHIVE_CRON=0 3 * * *

# ============================================
# Swap / FX Execution
# ============================================
# Maximum tolerated slippage as a fraction (0.005 = 0.5%, capped at 0.1)
SWAP_SLIPPAGE_PERCENT=0.005
SWAP_PREVIEW_CACHE_TTL_SECONDS=30

# ============================================
# Scheduled Jobs
# ============================================
# Pending transactions older than this are auto-failed by the scheduler
PENDING_TX_TIMEOUT_MINUTES=30

# ============================================
# Auth Rate Limiting
# ============================================
# Requests allowed per throttle window on auth routes
THROTTLE_AUTH_LIMIT=5
